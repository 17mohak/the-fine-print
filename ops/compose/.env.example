# Development-only values for the local Compose stack. NOT SECRETS: they protect nothing but synthetic data
# on a loopback-only stack. Copy to ops/compose/.env (git-ignored). Never reuse them anywhere else.
POSTGRES_DB=fineprint_dev
POSTGRES_USER=fineprint_dev
POSTGRES_PASSWORD=dev-only-postgres-not-a-secret
POSTGRES_PORT=5432

S3_PORT=8333

KC_ADMIN_USERNAME=dev-admin
KC_ADMIN_PASSWORD=dev-only-keycloak-admin-not-a-secret
IDP_PORT=8081
